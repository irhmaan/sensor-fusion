<?xml version="1.0"?>
<robot name="fourwd_robot">

  <!-- ====================== MATERIALS ====================== -->
  <material name="blue">
    <color rgba="0.2 0.4 1.0 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <!-- ====================== BASE (CHASSIS) ====================== -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry>
        <box size="0.5 0.3 0.1"/>          <!-- length x width x height -->
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <!-- ====================== WHEELS ====================== -->
  <!-- Front Left Wheel -->
  <link name="fl_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>   <!-- rotate cylinder to lie flat -->
      <geometry>
        <cylinder length="0.04" radius="0.065"/>  <!-- width, radius -->
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Front Right Wheel -->
  <link name="fr_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.065"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Rear Left Wheel -->
  <link name="rl_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.065"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- Rear Right Wheel -->
  <link name="rr_wheel">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.065"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <!-- ====================== JOINTS ====================== -->
  <!-- Front Left Joint -->
  <joint name="fl_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="fl_wheel"/>
    <origin xyz="0.18  0.15 -0.065" rpy="0 0 0"/>   <!-- x, y, z position -->
    <axis xyz="0 1 0"/>                              <!-- rotates around Y-axis -->
  </joint>

  <!-- Front Right Joint -->
  <joint name="fr_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="fr_wheel"/>
    <origin xyz="0.18 -0.15 -0.065" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Left Joint -->
  <joint name="rl_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rl_wheel"/>
    <origin xyz="-0.18  0.15 -0.065" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Rear Right Joint -->
  <joint name="rr_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rr_wheel"/>
    <origin xyz="-0.18 -0.15 -0.065" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>


  <!-- =============== SENSORS ==================== -->
  <link name="lidar_link">
    <visual>
      <origin xyz = "0 0 0" rpy="0 0 0" />
      <geometry>
        <cylinder length="0.05" radius="0.05"/>
      </geometry>
    </visual>
  </link>

  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.18 0 0.12" rpy ="0 0 0" />
  </joint>


  <link name="imu_link" >
        <visual>
      <origin xyz = "0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.06 0.03 0.05"/>    <!--- l*b*h -->
      </geometry>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.1" rpy="0 1.57 0"/>
  </joint>

</robot>